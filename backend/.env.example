# Database
DATABASE_URL=postgresql+asyncpg://coffee:coffee@localhost:5432/coffeecompass

# External APIs
GOOGLE_PLACES_API_KEY=your_google_places_key
OPENAI_API_KEY=your_openai_key

# Ingestion defaults
USC_LAT=34.0224
USC_LNG=-118.2851
INGEST_RADIUS_METERS=5000
INGEST_LIMIT=100

# LLM models
SLOT_EXTRACTOR_MODEL=gpt-4o-mini
REVIEW_TAGGER_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AGENT_MODEL=gpt-4o-mini

# review_tagger: v1 (Week 1) or v2 (Week 2 editorial + reviews)
REVIEW_TAGGER_IMPL=v1
